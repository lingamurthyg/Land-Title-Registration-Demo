    <!-- AWS SDK packages for cloud-native configuration and secrets management -->
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="3.7.300.0" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="3.7.300.0" />
    <PackageReference Include="AWSSDK.ServiceDiscovery" Version="3.7.300.0" />
    <PackageReference Include="AWS.Logger.Log4net" Version="3.5.0" />
    
    <!-- Redis for distributed caching and session state -->
    <PackageReference Include="StackExchange.Redis" Version="2.7.10" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.0" />
    
    <!-- Configuration and DI -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    
    <!-- Updated log4net to latest secure version -->
    <PackageReference Include="log4net" Version="2.0.15" />
    
    <!-- Updated to latest secure versions -->
    <PackageReference Include="NuGet.Frameworks" Version="6.8.0" />
    <PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" />
    
