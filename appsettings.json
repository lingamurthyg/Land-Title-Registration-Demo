{
  "ServiceUrls": {
    "DocumentService": "#{DOCUMENT_SERVICE_URL}#",
    "NotificationService": "#{NOTIFICATION_SERVICE_URL}#",
    "LegacySearchApi": "#{LEGACY_SEARCH_API_URL}#"
  },
  "FilePaths": {
    "ArchivePath": "#{ARCHIVE_PATH}#",
    "TempExport": "#{TEMP_EXPORT_PATH}#",
    "LogPath": "#{LOG_PATH}#"
  },
  "AWS": {
    "Region": "us-east-1",
    "ParameterStorePrefix": "/landtitle/",
    "SecretsManagerPrefix": "landtitle/"
  },
  "Redis": {
    "ConnectionString": "#{REDIS_CONNECTION_STRING}#"
  },
  "Logging": {
    "LogGroup": "/aws/landtitle/application",
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
